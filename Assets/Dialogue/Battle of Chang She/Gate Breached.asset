  m_Script: {fileID: 11500000, guid: 283e0fc76bae4ce43bdc77078ae055f2, type: 3}
  m_Name: Gate Breached
  m_EditorClassIdentifier: Assembly-CSharp::DialogConversation
  lines:
  - speakerName: Huangfu Song
    dialogText: 'Huangfu Song: What!? The gate has been breached?...'
    characterPortrait: {fileID: -882913721, guid: 7f7d7276e52e65f4690fdced0bacae71, type: 3}
    alignment: 0
    voiceSFXName: 
    customDuration: 4
  - speakerName: Huangfu Song
    dialogText: 'Huangfu Song: We must hold out a little longer...'
    characterPortrait: {fileID: -882913721, guid: 7f7d7276e52e65f4690fdced0bacae71, type: 3}
    alignment: 0
    voiceSFXName: 
    customDuration: 3
  - speakerName: Huangfu Song
    dialogText: 'Huangfu Song: I shall not die yet, the Han cannot be usurped by
      these rebals!'
    characterPortrait: {fileID: -882913721, guid: 7f7d7276e52e65f4690fdced0bacae71, type: 3}
    alignment: 0
    voiceSFXName: 
    customDuration: 4
  - speakerName: Huangfu Song
    dialogText: 'Huangfu Song: Thier encampment is the perfect place for a fire attack...Men,
      do whatever you can to get the Task Unit close enough!'
    characterPortrait: {fileID: -882913721, guid: 7f7d7276e52e65f4690fdced0bacae71, type: 3}
    alignment: 0
    voiceSFXName: 
    customDuration: 6
